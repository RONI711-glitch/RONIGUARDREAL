# Anybuild configuration for Wasmer (Node.js + Express full-stack with Vite frontend)
load("//anybuild/tools:node.bzl", "node_build", "node_config", "node_serve")

config = node_config(
    schema = 1,
    commands = {
        "start": "node server.js",
    },
    node_package_manager = "npm",
    node_server = "express",
    node_build_command = "npm run build",
    node_install_requires_all_files = True,
    node_version = "24",
    npm_version = "10.8.2",
)

build = node_build(config)

node_serve(config, build, name = "node-express")
