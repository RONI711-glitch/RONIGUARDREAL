{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "server.js",
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "NODE_ENV=production node server.js",
    "bot": "tsx server/botRunner.ts",
    "bot:vps": "node bot-vps.js",
    "build": "vite build && esbuild server.ts --platform=node --format=esm --bundle --packages=external --outfile=server.js && esbuild server/botRunner.ts --platform=node --format=esm --bundle --packages=external --outfile=bot-vps.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js bot-vps.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "ws": "^8.22.1",
    "esbuild": "^0.28.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
